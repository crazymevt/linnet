{:name linnet
 :version "0.1.0"
 :paths ["src"]
 ;; skein-ui is pinned to crazymevt/skein-ui#3 (window :icon) until it's
 ;; merged; then pin a commit on main. `skein deps` fetches them and writes
 ;; skein.lock. The renderer isn't in the repository: run.sh and the
 ;; Makefile point SKEIN_UI_HOST at a built one (see the README).
 :deps {skein-ui {:git "https://github.com/crazymevt/skein-ui.git"
                  :sha "2d3f05dd009d977a1b2f9ce1955dd2b02619c790"}
        skein-vlc {:git "https://github.com/crazymevt/skein-vlc.git"
                   :sha "6e6e32b5107227ff60f43bd999d9cd4545d75c3d"}}
 :main linnet.main/main
 :package {:id "dev.skein.linnet"
           :display-name "Linnet"
           :icon "assets/linnet-1024.png"
           :resources ["assets"]
           :targets [:app :cli]
           ;; skein package --windows --launcher …/skein.exe (on Windows, by
           ;; default the skein running): windowed, as a skein-ui app is
           :windows {:icon "assets/linnet.ico"}}}
