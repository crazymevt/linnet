;;;; Screenshots of each view, headless, from the fixture library:
;;;;   SKEIN_UI_HEADLESS=1 ../skein-lang/target/release/skein tools/screenshots.skn OUT-DIR
(require '[skein.ui :as ui] '[skein.io :as io] '[linnet.app :as app] '[linnet.store :as store]
         '[linnet.scan :as scan] '[linnet.player :as player] '[linnet.library :as library] '[skein.sys :as sys])
(def out (or (first (drop 2 (sys/args))) "shots"))
(io/mkdirs! out)
(def tmp (io/path (io/temp-directory) (str "linnet-shots-" (nano-time))))
(store/set-data-dir! tmp)
(ui/set-state-dir! (io/path tmp "ui"))
(ui/theme! linnet.theme/theme)
(def wid (app/start! {:scan? false}))
(defn settle [] (ui/settle!) (sleep 300))
(defn shot [name] (settle) (println "shot" name (ui/screenshot wid (io/path out (str name ".png")) 1)))
(shot "01-welcome")
(scan/add-folder! app/lib-atom (io/canonical "tests/fixtures/music") (fn [_]))
(shot "02-albums")
(app/go! [:songs]) (shot "03-songs")
(player/play-queue! @app/ctl (mapv :path (library/sort-tracks (library/tracks @app/lib-atom) nil)) 0)
(sleep 700)
(app/go! [:album ["Marigold Strings" "Dawn Suite"]]) (shot "04-album")
(app/go! [:folders]) (shot "05-folders")
(app/go! [:artists]) (shot "06-artists")
(app/go! [:now-playing]) (shot "07-now-playing")
(app/edit-info! (player/current-path (player/state @app/ctl))) (shot "08-edit")
(swap! app/ui-state assoc :dialog nil)
(app/stop!)
(sys/exit 0)
